{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["react", "react-dom", "vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": false,
    "paths": {
      "@core/*": ["../emdash-desktop/src/core/*"],
      "@root/src/core/*": ["../emdash-desktop/src/core/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
